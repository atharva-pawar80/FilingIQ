# Copy this file to `.env` in the same folder and fill in real values.
# `.env` is gitignored — NEVER commit real API keys to GitHub.

# Groq API key — free tier, get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Which Groq-hosted model to use for generation
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding model (runs locally via sentence-transformers, no API key needed)
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Where Chroma persists its vector store on disk
CHROMA_PERSIST_DIR=./vectorstore

# Where raw downloaded 10-K HTML files live
RAW_FILINGS_DIR=./data/raw_filings

# CORS — comma-separated list of allowed frontend origins
# (local dev + your eventual Vercel URL)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
